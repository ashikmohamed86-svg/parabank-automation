{
  "name": "parabank-automation",
  "version": "1.0.0",
  "description": "BDD + Page Object Model end-to-end automation for the ParaBank sign-up and login flow, built with Playwright and TypeScript.",
  "author": "Ashik Mohamed",
  "license": "MIT",
  "private": true,
  "scripts": {
    "bddgen": "bddgen",
    "test": "bddgen && playwright test",
    "test:headed": "bddgen && playwright test --headed",
    "test:trace": "bddgen && playwright test --trace on",
    "test:trace:headed": "bddgen && playwright test --headed --trace on",
    "test:registration": "bddgen && playwright test --grep @registration",
    "test:login": "bddgen && playwright test --grep @login",
    "test:smoke": "bddgen && playwright test --grep @smoke",
    "test:boundary": "bddgen && playwright test --grep @boundary",
    "test:security": "bddgen && playwright test --grep @security",
    "test:access": "bddgen && playwright test --grep @access",
    "test:performance": "bddgen && playwright test --grep @performance",
    "report": "playwright show-report",
    "report:monocart": "open monocart-report/index.html",
    "report:dashboard": "open monocart-report/dashboard.html",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf .features-gen playwright-report monocart-report test-results blob-report"
  },
  "keywords": [
    "playwright",
    "playwright-bdd",
    "cucumber",
    "gherkin",
    "page-object-model",
    "parabank",
    "test-automation",
    "typescript"
  ],
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/node": "^22.10.0",
    "monocart-reporter": "^2.11.2",
    "playwright-bdd": "^8.5.1",
    "typescript": "^5.7.0"
  }
}
